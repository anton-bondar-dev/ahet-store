# Ahet Store — environment template.
# Copy the backend section to `backend/.env` and the frontend line to
# `frontend/.env.local`, then fill in real values. NEVER commit real secrets.

# ─── Backend (backend/.env) ──────────────────────────────────────────────────

# Django
SECRET_KEY=generate_a_random_secret_key
DEBUG=True
# Required when DEBUG=False (comma-separated), e.g. ahet.store,www.ahet.store
ALLOWED_HOSTS=
# Extra CORS origins for the production frontend (comma-separated), e.g.
# https://ahet.store
CORS_ALLOWED_ORIGINS=

# PostgreSQL
DB_NAME=ahet_store
DB_USER=ahet_store_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Telegram login bot (2FA)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=YourStoreBot
TELEGRAM_INSECURE_SKIP_TLS_VERIFY=false

# Google Sign-In (server verifies the ID token's audience against this)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Outgoing email (SMTP) — e.g. a Gmail account + App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password

# Password used by `manage.py create_support_admin`
SUPPORT_ADMIN_PASSWORD=change_me_support_admin

# ─── Frontend (frontend/.env.local) ──────────────────────────────────────────

# Public Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Backend API origin (defaults to http://127.0.0.1:8000 for dev)
VITE_API_URL=http://127.0.0.1:8000
