# Ahet Store — environment template.
# Copy the backend section to `backend/.env` and the frontend line to
# `frontend/.env.local`, then fill in real values. NEVER commit real secrets.

# ─── Backend (backend/.env) ──────────────────────────────────────────────────

# Django
SECRET_KEY=generate_a_random_secret_key
DEBUG=True

# PostgreSQL
DB_NAME=ahet_store
DB_USER=ahet_store_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Telegram login bot (2FA)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=YourStoreBot
TELEGRAM_INSECURE_SKIP_TLS_VERIFY=false
# Chat id(s) that receive admin alerts + drive the interactive bot menu.
# One id, or several comma-separated (each staff member's chat, or a group id).
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
# Optional shared secret checked on the Telegram webhook (prod)
TELEGRAM_WEBHOOK_SECRET=optional_random_webhook_secret
# Public frontend origin (used for workspace links in bot replies)
FRONTEND_URL=http://localhost:5173

# Google Sign-In (server verifies the ID token's audience against this)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Outgoing email (SMTP) — e.g. a Gmail account + App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password

# Password used by `manage.py create_support_admin`
SUPPORT_ADMIN_PASSWORD=change_me_support_admin

# ─── Frontend (frontend/.env.local) ──────────────────────────────────────────

# Public Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
